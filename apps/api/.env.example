# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://aquaculture:aquaculture@127.0.0.1:5432/aquaculture
AUTO_CREATE_TABLES=true

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks_dev_v1
QDRANT_VECTOR_SIZE=1024

# --- Redis / ARQ ---
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE=arq:queue

# --- 生成 ---
# mock: 不调用外部 API，按检索证据拼装回答，便于离线跑通
# deepseek: 调用 DeepSeek API
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 检索 ---
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=8

# --- 存储 ---
DATA_DIR=../../data
MAX_UPLOAD_MB=100