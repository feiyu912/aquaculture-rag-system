# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://aquaculture:aquaculture@127.0.0.1:5432/aquaculture
AUTO_CREATE_TABLES=true

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks_bge_m3_v1
QDRANT_VECTOR_SIZE=1024

# --- Redis / ARQ ---
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE=arq:queue

# --- 生成 ---
# mock: 不调用外部 API，按检索证据拼装回答，便于离线跑通
# deepseek: 调用 DeepSeek API
# openai_compatible: 其他 OpenAI 兼容服务（SiliconFlow / vLLM / OpenAI 等）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 0 表示只记录 token，不计价；填当前价格后再用于成本统计
DEEPSEEK_PRICE_INPUT_PER_M=0
DEEPSEEK_PRICE_OUTPUT_PER_M=0
OPENAI_PRICE_INPUT_PER_M=0
OPENAI_PRICE_OUTPUT_PER_M=0
# 仅 LLM_PROVIDER=openai_compatible 时使用；key 写在这里，不要提交
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- 真实嵌入模型 ---
# 需要先运行: uv sync --extra bge
# 开发回退才使用 hashing-dev-1024；论文实验必须使用 BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
# auto | mps | cuda | cpu
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024
# 集合 manifest 与配置不一致时阻止检索；旧集合迁移期间可临时关闭
INDEX_MANIFEST_REQUIRED=true

# --- 检索 ---
# dense | bm25 | hybrid | hybrid_rerank
DEFAULT_RETRIEVAL_MODE=hybrid
# noop 仅用于消融对照；只有 BAAI/bge-reranker-v2-m3 才能称为真实重排
# 也可以填本地模型目录（离线部署）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 本地模型目录（可选，断网部署时填写）
RERANKER_PATH=
RERANKER_DEVICE=auto
RERANKER_USE_FP16=false
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=8
MAX_SOURCES=5
# 证据不足门槛：至少匹配词数、加权词数、覆盖率
EVIDENCE_MIN_TERMS=2
EVIDENCE_MIN_WEIGHT=3
EVIDENCE_MIN_COVERAGE=0.3

# --- 增强模块开关（默认关闭，便于消融；Query IR 默认开启但不改变硬过滤行为）---
ENABLE_QUERY_IR=true
# LLM planner 默认关闭；开启后每次首轮检索前多一次模型调用（仅首轮）
ENABLE_LLM_PLANNER=false
PLANNER_MAX_TOKENS=2000
PLANNER_TEMPERATURE=0
ENABLE_CLAIM_VERIFICATION=true
ENABLE_CONTEXTUAL_RETRIEVAL=false
ENABLE_EVIDENCE_REQUIREMENTS=false
ENABLE_TARGETED_RETRIEVAL=false
ENABLE_QUERY_DECOMPOSITION=false
MAX_QUERY_VARIANTS=4
ENABLE_GRAPH_EXPANSION=false
GRAPH_TOP_K=10
GRAPH_RRF_WEIGHT=0.7
ENABLE_ADAPTIVE_ROUTING=false
MAX_TARGETED_RETRIEVAL=1

# --- 存储 ---
DATA_DIR=../../data
MAX_UPLOAD_MB=100