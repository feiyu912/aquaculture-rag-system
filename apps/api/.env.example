# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://aquaculture:aquaculture@127.0.0.1:5432/aquaculture
AUTO_CREATE_TABLES=true

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks_dev_v1
QDRANT_VECTOR_SIZE=1024

# --- Redis / ARQ ---
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE=arq:queue

# --- 生成 ---
# mock: 不调用外部 API，按检索证据拼装回答，便于离线跑通
# deepseek: 调用 DeepSeek API
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 0 表示只记录 token，不计价；填当前价格后再用于成本统计
DEEPSEEK_PRICE_INPUT_PER_M=0
DEEPSEEK_PRICE_OUTPUT_PER_M=0

# --- 检索 ---
# dense | bm25 | hybrid | hybrid_rerank
DEFAULT_RETRIEVAL_MODE=hybrid
# noop | BAAI/bge-reranker-v2-m3
RERANKER_MODEL=noop
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=8
MAX_SOURCES=5
# 证据不足门槛：至少匹配词数、加权词数、覆盖率
EVIDENCE_MIN_TERMS=2
EVIDENCE_MIN_WEIGHT=3
EVIDENCE_MIN_COVERAGE=0.3

# --- 增强模块开关（默认关闭，便于消融；Query IR 默认开启但不改变硬过滤行为）---
ENABLE_QUERY_IR=true
ENABLE_CLAIM_VERIFICATION=true
ENABLE_CONTEXTUAL_RETRIEVAL=false
ENABLE_EVIDENCE_REQUIREMENTS=false
ENABLE_TARGETED_RETRIEVAL=false
ENABLE_GRAPH_EXPANSION=false
GRAPH_TOP_K=10
GRAPH_RRF_WEIGHT=0.7
ENABLE_ADAPTIVE_ROUTING=false
MAX_TARGETED_RETRIEVAL=1

# --- 存储 ---
DATA_DIR=../../data
MAX_UPLOAD_MB=100